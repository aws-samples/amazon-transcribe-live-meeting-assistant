{
  "name": "lma-virtual-participant-app",
  "private": true,
  "version": "1.0.0",
  "description": "LMA Virtual Participant Application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:page",
    "build:page": "tsc --project tsconfig.page.json && esbuild src/teams-sdk-page.ts --bundle --format=iife --platform=browser --minify --outfile=dist/teams-sdk-page.bundle.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js",
    "dev": "ts-node --esm src/index.ts",
    "dev:watch": "npx nodemon --watch src --ext ts --exec 'npm run build && npm run start'"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@aws-sdk/client-comprehend": "^3.1111.0",
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1111.0",
    "@aws-sdk/client-kinesis": "^3.1111.0",
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-secrets-manager": "^3.1111.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1111.0",
    "@aws-sdk/credential-provider-node": "^3.726.1",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "@aws-sdk/util-dynamodb": "^3.726.1",
    "@azure/communication-calling": "1.43.1",
    "@azure/communication-chat": "1.6.0",
    "@azure/communication-common": "2.5.0",
    "@azure/communication-identity": "1.3.1",
    "@azure/communication-react": "1.33.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.2",
    "@zoom/meetingsdk": "6.2.0",
    "aws-amplify": "^6.20.0",
    "aws-sigv4-fetch": "^4.3.0",
    "axios": "^1.19.0",
    "cloakbrowser": "0.5.7",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.62.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "simli-client": "3.0.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-xml-parser@4": "^4.5.6",
    "jws": "^3.2.3",
    "hono": "^4.12.25",
    "ws": "^8.21.0",
    "ajv@8": "^8.18.0",
    "form-data@4": "^4.0.6"
  }
}
