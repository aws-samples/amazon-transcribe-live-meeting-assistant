  "surfaces": {
    "transcriber-websocket": {
      "title": "WebSocket transcriber (Stream Audio/Video page, browser extension, Desktop Capture App)",
      "control": "The transcriber verifies the access token on every request except its health check and answers 403 to a role the matrix does not list.",
      "enforcedIn": "lma-websocket-transcriber-stack/source/app/src/utils/jwt-verifier.ts",
      "tests": ["lma-websocket-transcriber-stack/source/app/src/utils/roles.test.ts", "integ-tests/test_role_access.py"]
    },
    "identity-pool-credentials": {
      "title": "Cognito identity pool credentials for the web UI",
      "control": "The identity pool chooses the IAM role from the ID token's lma_role claim: Admin and User receive the web UI's authenticated role; Participant receives a role with no permissions; a token without a recognised role receives no credentials.",
      "enforcedIn": "lma-cognito-stack/deployment/lma-cognito-stack.yaml",
      "tests": ["lma-ai-stack/test/test_role_matrix.py", "integ-tests/test_role_access.py"]
    },
    "mcp-api-key-endpoint": {
      "title": "Hosted MCP server, API key endpoint",
      "control": "The API key authorizer reads the key owner's current groups from the user pool on every request and refuses the key unless the owner's role is listed; the MCP server refuses a request whose authorizer context names an unlisted role.",
      "enforcedIn": "lma-ai-stack/source/lambda_functions/mcp_api_key_authorizer/index.py",
      "tests": ["lma-ai-stack/source/lambda_functions/mcp_api_key_authorizer/test_authorizer.py", "lma-ai-stack/source/lambda_functions/mcp_analytics/test_roles.py", "integ-tests/test_role_access.py"]
    },
    "mcp-oauth-gateway": {
      "title": "Hosted MCP server, OAuth gateway",
      "control": "The MCP server derives the caller's role from the cognito:groups claim the gateway forwards and refuses an unlisted role.",
      "enforcedIn": "lma-ai-stack/source/lambda_functions/mcp_analytics/index.py",
      "tests": ["lma-ai-stack/source/lambda_functions/mcp_analytics/test_roles.py"]
    }
  },
  "probe": {
    "description": "How integ-tests/test_role_access.py calls the operations. Every operation is called as each role it refuses, with placeholder arguments, and must be refused by AppSync before its resolver runs. Queries are also called as each role they admit and must not be refused; mutations are not, since they change data. Queries listed under skipAllowed call a model and are called only as the roles they refuse. The resolvers of the queries under placeholderRefusedForNonAdmins refuse a non-Admin for a meeting they cannot see, which a placeholder meeting always is, in the same words as AppSync, so they are called only as Admin among the roles they admit. Subscriptions are held to the matrix by the schema contract test only.",
    "skipAllowed": ["Query.queryKnowledgeBase", "Query.parseMeetingInvitation"],
    "placeholderRefusedForNonAdmins": ["Query.listMeetingNotifications", "Query.getMyMeetingNotificationState"]
  }
}
