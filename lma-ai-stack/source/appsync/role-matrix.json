{
  "description": "Who may use what in LMA. The single source of truth for the roles of every AppSync operation, every other surface that accepts a user pool token, and every web UI route. lma-ai-stack/test/test_role_matrix.py holds schema.graphql, the role table in docs/user-based-access-control.md and the surface list to this file; the UI, transcriber and Lambda tests named under effectiveRole hold their copies of the role rule to its vectors; integ-tests/test_role_access.py calls the operations on a deployed stack as each role.",
  "roles": {
    "Admin": "Member of the Admin Cognito group. Every meeting, the configuration and user management.",
    "User": "A user in neither the Admin nor the Participant group. Their own meetings and those shared with them, and every meeting source.",
    "Participant": "Member of the Participant Cognito group. Signs in to a minimal home page; no meeting data, meeting sources or configuration."
  },
  "effectiveRole": {
    "description": "A caller's role from their Cognito groups: Admin when the groups include Admin, otherwise Participant when they include Participant, otherwise User. The pre token generation trigger replaces the role groups in each token's cognito:groups claim with this one role, keeps any other group, and adds the role to the ID token as the lma_role claim. Implemented by lma-cognito-stack/source/pre_token_generation/index.py, lma-ai-stack/source/ui/src/components/common/roles.js, lma-websocket-transcriber-stack/source/app/src/utils/roles.ts, mcp_api_key_authorizer, mcp_analytics/index.py and user_management; each one's tests check it against these vectors.",
    "precedence": ["Admin", "Participant", "User"],
    "default": "User",
    "vectors": [
      { "groups": [], "role": "User" },
      { "groups": ["User"], "role": "User" },
      { "groups": ["Admin"], "role": "Admin" },
      { "groups": ["Participant"], "role": "Participant" },
      { "groups": ["Admin", "Participant"], "role": "Admin" },
      { "groups": ["Participant", "User"], "role": "Participant" },
      { "groups": ["Admin", "User"], "role": "Admin" },
      { "groups": ["SomeOtherGroup"], "role": "User" },
      { "groups": ["SomeOtherGroup", "Participant"], "role": "Participant" },
      { "groups": ["admin"], "role": "User" },
      { "groups": ["participant"], "role": "User" }
    ]
  },
