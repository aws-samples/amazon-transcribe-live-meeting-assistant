## Published to the onAddVideoKeyframe subscription, filtered on SharedWith in
## subscription.js. The frame is returned as written, apart from that field.
#if( $context.result )
  #set( $sharedWithRaw = $util.defaultIfNull($context.result.SharedWith, "") )
## BEGIN SharedWith entries -- one text in every template that reads SharedWith;
## test_shared_with_access.py holds the copies to it.
## Reads $sharedWithRaw into $sharedWithEntries, a list of trimmed, non-empty
## entries, from every shape SharedWith is stored in: a List (shareCall and
## shareTranscriptSegment write one), a string set, and a comma-separated or
## "[a, b]" String (older meeting rows; transcript segments and key frames, which
## take the meeting's SharedWith as getCall returns it; Virtual Participant rows).
## Membership is then a comparison of whole entries, as in the Lambda resolvers.
## Every template sets $sharedWithRaw through $util.defaultIfNull(..., ""): a
## #set whose value is null leaves the variable as it was, which in a loop
## would carry one item's SharedWith over to the next.
#set( $sharedWithEntries = [] )
#if( $util.isList($sharedWithRaw) )
  #foreach( $sharedWithEntry in $sharedWithRaw )
    #if( $util.isString($sharedWithEntry) && !$sharedWithEntry.trim().isEmpty() )
      $util.qr( $sharedWithEntries.add($sharedWithEntry.trim()) )
    #end
  #end
#elseif( $util.isString($sharedWithRaw) )
  #set( $sharedWithText = $sharedWithRaw.trim() )
  #if( $sharedWithText.startsWith("[") )
    #set( $sharedWithText = $sharedWithText.substring(1) )
  #end
  #if( $sharedWithText.endsWith("]") )
    #set( $sharedWithEnd = $sharedWithText.length() - 1 )
    #set( $sharedWithText = $sharedWithText.substring(0, $sharedWithEnd) )
  #end
  #foreach( $sharedWithEntry in $sharedWithText.split(",") )
    #if( !$sharedWithEntry.trim().isEmpty() )
      $util.qr( $sharedWithEntries.add($sharedWithEntry.trim()) )
    #end
  #end
#end
## END SharedWith entries
  #set( $sharedWithTarget = $context.result )
## BEGIN SharedWith published -- one text in every template that publishes it;
## test_shared_with_access.py holds the copies to it.
## Writes $sharedWithEntries back into $sharedWithTarget as "[a, b]", the form a
## List-shaped SharedWith already reaches clients in, so that every message the
## filters in subscription.js are applied to carries SharedWith in one shape and
## they can match whole entries by their delimiters. A value with no entries is
## left as it is.
#if( !$sharedWithEntries.isEmpty() )
  #set( $sharedWithPublished = "[" )
  #foreach( $sharedWithEntry in $sharedWithEntries )
    #set( $sharedWithPublished = "${sharedWithPublished}${sharedWithEntry}" )
    #if( $foreach.hasNext )
      #set( $sharedWithPublished = "${sharedWithPublished}, " )
    #end
  #end
  #set( $sharedWithPublished = "${sharedWithPublished}]" )
  $util.qr( $sharedWithTarget.put("SharedWith", $sharedWithPublished) )
#end
## END SharedWith published
#end
$util.toJson($context.result)
