#if ( $ctx.error )
  $util.error($ctx.error.message, $ctx.error.type)
#end

## Same rule as getTranscriptSegments: a Cognito user sees the frames of meetings
## they own or that are shared with them, an admin sees all, and a backend role
## (IAM, e.g. the meeting assistant) is unrestricted.

#set($isCognitoUser = true)
#if($context.identity.userArn && $context.identity.userArn.contains(":assumed-role/"))
  #set($isCognitoUser = false)
#end

#if(!$context.identity.groups.contains("Admin") && $isCognitoUser)
  #set($myResults = [])
  #foreach($item in $context.result.items)
    #if($item.Owner == $context.identity.username || $item.SharedWith.contains($context.identity.username))
      #set($added = $myResults.add($item))
    #end
  #end
  $util.toJson({"VideoKeyframes": $myResults, "nextToken": $ctx.result.nextToken})
#else
  $util.toJson({"VideoKeyframes": $ctx.result.items, "nextToken": $ctx.result.nextToken})
#end
