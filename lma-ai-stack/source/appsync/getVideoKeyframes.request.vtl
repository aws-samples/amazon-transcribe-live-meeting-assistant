## The meeting's key frames in time order (the sort key is f#<zero-padded ms>-<id>),
## a page at a time. Access is filtered in the response template.
#set( $PK = "kf#${ctx.args.callId}" )
#set( $limit = $util.defaultIfNull($ctx.args.limit, 200) )
#if( $limit > 500 )
  #set( $limit = 500 )
#end
#if( $limit < 1 )
  #set( $limit = 1 )
#end

{
  "version" : "2018-05-29",
  "operation" : "Query",
  "query" : {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "PK",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toDynamoDBJson($PK),
    },
  },
  "scanIndexForward": true,
  "limit": $limit,
  #if( $ctx.args.nextToken )
  "nextToken": $util.toJson($ctx.args.nextToken),
  #end
}
