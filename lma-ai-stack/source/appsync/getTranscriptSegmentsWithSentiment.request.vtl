#set( $PK = "trs#${ctx.args.callId}" )
#set( $isPartial = false )

## A segment stored by LMA before 0.4.0 may have the Channel CATEGORY_MATCH,
## which the schema's Channel enum no longer declares. Such an item cannot be
## returned as a TranscriptSegment, so the query leaves it out; it expires with
## the rest of the meeting's transcript. An item without a Channel is unaffected.
## test_transcript_segment_channels.py holds this filter in place.
{
  "version" : "2018-05-29",
  "operation" : "Query",
  "query" : {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "PK",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toDynamoDBJson($PK),
    },
  },
  "filter": {
    "expression": "#IsPartial = :isPartial AND (attribute_not_exists(#Channel) OR #Channel <> :retiredChannel)",
    "expressionNames": {
      "#IsPartial": "IsPartial",
      "#Channel": "Channel",
    },
    "expressionValues": {
      ":isPartial": $util.dynamodb.toDynamoDBJson($isPartial),
      ":retiredChannel": $util.dynamodb.toDynamoDBJson("CATEGORY_MATCH"),
    },
  },
}