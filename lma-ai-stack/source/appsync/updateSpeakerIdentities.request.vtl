## Write the per-meeting speaker identity map.
##
## This has its own template rather than sharing updateCall.request.vtl for two
## reasons. That template SETs every key present in the input, which is safe only
## because every mutation using it is reachable by IAM callers alone; this field
## is written from the browser, so the update is spelled out attribute by
## attribute instead. And a browser caller has to be held to the same access rule
## the read path applies in getCall.response.vtl -- Admin, the meeting's owner, or
## a user it has been shared with -- which is expressed below as a DynamoDB
## condition so the check and the write are one atomic operation. This is the
## second function of a pipeline; the first, authorizeCallWrite, reads the
## meeting so the condition can compare SharedWith's entries whole in every shape
## it is stored in.
##
## UpdatedAt is deliberately NOT written here, and not used as a guard. Every
## other Call update carries `#UpdatedAt < :UpdatedAt` so that out-of-order events
## from the Kinesis pipeline cannot clobber newer state. A speaker rename is not
## one of those events: it is a deliberate user action, and last-write-wins by the
## person doing the renaming is the behaviour wanted. Leaving UpdatedAt alone also
## keeps a rename from interacting with that guard in either direction -- renaming
## during a live meeting neither fails because the pipeline moved UpdatedAt ahead,
## nor causes the next aggregation update to be rejected because the rename did.
#set( $PK = "c#${ctx.args.input.CallId}" )

## A Lambda calling with IAM credentials arrives as an assumed role; a signed-in
## user arrives through Cognito. Same detection as getCall.response.vtl.
#set( $isCognitoUser = true )
#if( $context.identity.userArn && $context.identity.userArn.contains(":assumed-role/") )
  #set( $isCognitoUser = false )
#end

#set( $conditionNames = { "#PK": "PK" } )
#set( $conditionValues = {} )
#set( $condition = "attribute_exists(#PK)" )

## `contains` on a List compares whole elements -- verified against a live stack,
## a member accepted and a non-member refused, because the DynamoDB reference
## documents `contains` for String substrings and Set members only.
## BEGIN SharedWith write condition -- one text in every template that has it;
## test_shared_with_access.py holds the copies to it.
## A signed-in caller who is not an Admin may write as the meeting's owner or as
## an entry of its SharedWith. authorizeCallWrite, the function before this one,
## read the meeting and recorded in the stash which of the two the caller is;
## the condition below re-states that finding atomically with the write, so a
## meeting re-shared or re-owned in between is judged as it is at the write:
##   owner        -- #Owner is still the caller;
##   shared-list  -- SharedWith is still a List or string set holding the caller
##                   as an element (on those two types `contains` compares
##                   whole elements);
##   shared-text  -- SharedWith is still the exact String that was read, whose
##                   entries include the caller.
## Any other caller is held to #Owner = :caller, which fails for them.
#if( $isCognitoUser && !$context.identity.groups.contains("Admin") )
  $util.qr( $conditionNames.put("#Owner", "Owner") )
  $util.qr( $conditionValues.put(":caller", $util.dynamodb.toDynamoDB($context.identity.username)) )
  #if( $ctx.stash.callerAccess == "shared-list" )
    $util.qr( $conditionNames.put("#SharedWith", "SharedWith") )
    $util.qr( $conditionValues.put(":sharedWithList", $util.dynamodb.toDynamoDB("L")) )
    $util.qr( $conditionValues.put(":sharedWithSet", $util.dynamodb.toDynamoDB("SS")) )
    #set( $condition = "${condition} AND (#Owner = :caller OR ((attribute_type(#SharedWith, :sharedWithList) OR attribute_type(#SharedWith, :sharedWithSet)) AND contains(#SharedWith, :caller)))" )
  #elseif( $ctx.stash.callerAccess == "shared-text" )
    $util.qr( $conditionNames.put("#SharedWith", "SharedWith") )
    $util.qr( $conditionValues.put(":sharedWithAsRead", $util.dynamodb.toDynamoDB($ctx.stash.sharedWithAsRead)) )
    #set( $condition = "${condition} AND (#Owner = :caller OR #SharedWith = :sharedWithAsRead)" )
  #else
    #set( $condition = "${condition} AND #Owner = :caller" )
  #end
#end
## END SharedWith write condition

{
  "version" : "2018-05-29",
  "operation" : "UpdateItem",
  "key": {
    "PK": $util.dynamodb.toDynamoDBJson($PK),
    "SK": $util.dynamodb.toDynamoDBJson($PK)
  },
  "update" : {
    "expression": "SET #SpeakerIdentities = :SpeakerIdentities",
    "expressionNames": {
      "#SpeakerIdentities": "SpeakerIdentities"
    },
    "expressionValues": {
      ":SpeakerIdentities": $util.dynamodb.toDynamoDBJson($ctx.args.input.SpeakerIdentities)
    }
  },
  "condition": {
    "expression": "$condition",
    "expressionNames": $utils.toJson($conditionNames)
    #if( !${conditionValues.isEmpty()} )
      , "expressionValues": $utils.toJson($conditionValues)
    #end
  }
}
