{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lma:configuration/call_pricing",
  "title": "Meeting cost prices",
  "description": "The unit prices each meeting's estimated cost is calculated with, in US dollars, and where each shipped price came from. Change a price to use your own rate, for example a private pricing agreement; the meeting's Details tab then shows that line at your price, with the shipped price beside it.",
  "sectionLabel": "Meeting Cost Prices",
  "order": 5,
  "collapsible": true,
  "defaultExpanded": false,
  "mergeStrategy": "merge",
  "widget": "priceTable",
  "type": "object",
  "properties": {
    "regions": {
      "order": 0,
      "type": "object",
      "title": "Prices",
      "description": "Prices by region, then by service, then by unit. The prices under \"default\" are those of the base region and apply wherever a region lists no price of its own.",
      "keyLabel": "Region",
      "itemLabel": "Region",
      "propertyNames": { "pattern": "^(default|[a-z]{2}(-gov)?-[a-z]+-[0-9])$" },
      "additionalProperties": {
        "type": "object",
        "title": "Services",
        "keyLabel": "Service",
        "itemLabel": "Service",
        "propertyNames": { "pattern": "^[a-z0-9-]+/.+$" },
        "additionalProperties": {
          "type": "object",
          "title": "Units",
          "keyLabel": "Unit",
          "itemLabel": "Unit",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "additionalProperties": {
            "type": "number",
            "title": "USD per unit",
            "minimum": 0
          }
        }
      }
    },
    "sources": {
      "order": 1,
      "type": "object",
      "title": "Price sources",
      "description": "Where each shipped price came from, by region and service, laid out as the prices are.",
      "keyLabel": "Region",
      "itemLabel": "Region",
      "propertyNames": { "pattern": "^(default|[a-z]{2}(-gov)?-[a-z]+-[0-9])$" },
      "additionalProperties": {
        "type": "object",
        "title": "Services",
        "keyLabel": "Service",
        "itemLabel": "Service",
        "propertyNames": { "pattern": "^[a-z0-9-]+/.+$" },
        "additionalProperties": {
          "type": "object",
          "title": "Source",
          "properties": {
            "basis": {
              "type": "string",
              "title": "Basis",
              "enum": ["price-list-api", "pricing-page", "estimate"],
              "enumLabels": {
                "price-list-api": "AWS Price List API",
                "pricing-page": "AWS pricing page",
                "estimate": "Estimate"
              }
            },
            "offer": { "type": "string", "title": "Price List offer", "maxLength": 128 },
            "offerVersion": { "type": "string", "title": "Offer version", "maxLength": 64 },
            "usageType": { "type": "string", "title": "Usage type", "maxLength": 256 },
            "retrieved": {
              "type": "string",
              "title": "Read on",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "url": { "type": "string", "title": "Pricing page", "pattern": "^https://", "maxLength": 512 },
            "detail": { "type": "string", "title": "Detail", "format": "textarea", "rows": 2, "maxLength": 1000 }
          },
          "additionalProperties": false
        }
      }
    },
    "baseRegion": {
      "order": 2,
      "type": "string",
      "title": "Base region",
      "description": "The region whose prices are listed under \"default\".",
      "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$"
    },
    "pricedRegions": {
      "order": 3,
      "type": "array",
      "title": "Regions with their own prices",
      "description": "An estimate for usage in a region not listed here says that it used the base region's prices.",
      "itemLabel": "Region",
      "items": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" }
    },
    "nonChargeableUnits": {
      "order": 4,
      "type": "array",
      "title": "Units shown without a price",
      "description": "Counted on the estimate for reference, such as requests, and not billed on their own.",
      "itemLabel": "Unit",
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
    },
    "notes": {
      "order": 5,
      "type": "object",
      "title": "How usage is measured",
      "description": "Shown on the estimate beside a service's lines.",
      "keyLabel": "Service",
      "itemLabel": "Note",
      "additionalProperties": { "type": "string", "format": "textarea", "rows": 2 }
    },
    "notIncluded": {
      "order": 6,
      "type": "array",
      "title": "Not included",
      "description": "Shown on every estimate as what it leaves out.",
      "itemLabel": "Item",
      "items": { "type": "string", "format": "textarea", "rows": 2 }
    },
    "pricesAsOf": {
      "order": 7,
      "type": "string",
      "title": "Prices as of",
      "description": "The date the shipped prices were read, as YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "order": 8,
      "type": "string",
      "title": "Source of the shipped prices",
      "format": "textarea",
      "rows": 2
    },
    "currency": {
      "order": 9,
      "type": "string",
      "title": "Currency",
      "description": "Every price is in US dollars.",
      "enum": ["USD"]
    }
  },
  "additionalProperties": false
}
