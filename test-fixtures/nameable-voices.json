      "segments": [
        {"channel": "REMOTE", "speaker": "Other Participant (spk_0)", "start": 0, "transcript": "Hi"},
        {"channel": "REMOTE", "speaker": "Other Participant (spk_1)", "start": 5, "transcript": "Hello"}
      ],
      "keys": ["REMOTE#Other Participant (spk_0)", "REMOTE#Other Participant (spk_1)"]
    },
    {
      "name": "a Stream Audio channel's typed label split into two voices needs names",
      "captureSource": "STREAM_AUDIO",
      "segments": [
        {"channel": "REMOTE", "speaker": "alex@example.com (spk_0)", "start": 0, "transcript": "Hi"},
        {"channel": "REMOTE", "speaker": "alex@example.com (spk_1)", "start": 5, "transcript": "Hello"}
      ],
      "keys": ["REMOTE#alex@example.com (spk_0)", "REMOTE#alex@example.com (spk_1)"]
    },
    {
      "name": "a meeting with no capture source keeps the structural rule",
      "segments": [
        {"channel": "REMOTE", "speaker": "Bob Strahan (spk_0)", "start": 0, "transcript": "Hi Jeremy"},
        {"channel": "REMOTE", "speaker": "Bob Strahan (spk_1)", "start": 5, "transcript": "Can you hear me?"}
      ],
      "keys": ["REMOTE#Bob Strahan (spk_0)", "REMOTE#Bob Strahan (spk_1)"]
    },
    {
      "name": "a Virtual Participant meeting's conference room voices need names",
      "captureSource": "VIRTUAL_PARTICIPANT",
      "segments": [
        {"channel": "REMOTE", "speaker": "Northwind Board Room (spk_0)", "start": 0, "transcript": "Hi, I'm Grace"},
        {"channel": "REMOTE", "speaker": "Northwind Board Room (spk_1)", "start": 5, "transcript": "And I'm Sam"}
