        {"channel": "REMOTE", "speaker": "Bob Strahan (spk_0)", "start": 0, "transcript": "Hi, I'm Grace"},
        {"channel": "REMOTE", "speaker": "Bob Strahan (spk_1)", "start": 5, "transcript": "And I'm Sam"}
