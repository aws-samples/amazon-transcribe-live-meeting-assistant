{
  "description": "Meeting chat text and the web addresses found in it, in order. Read by lma_chat_links' tests (lma-ai-stack/source/lambda_layers/configuration_layer/lma_chat_links) and by the tests of its UI twin, chat-links.js (lma-ai-stack/source/ui/src/components/common/chat-links.test.js), so the two apply the same rules.",
  "cases": [
    {"name": "plain https", "input": "see https://example.com/a for it", "urls": ["https://example.com/a"]},
    {"name": "plain http", "input": "http://example.com", "urls": ["http://example.com"]},
    {"name": "www form gets https", "input": "go to www.example.com/docs now", "urls": ["https://www.example.com/docs"]},
    {"name": "scheme lower-cased, rest kept", "input": "HTTPS://Example.com/Path", "urls": ["https://Example.com/Path"]},
    {"name": "trailing full stop", "input": "Read https://example.com/a.", "urls": ["https://example.com/a"]},
    {"name": "trailing punctuation run", "input": "really? https://example.com/q?x=1!?...", "urls": ["https://example.com/q?x=1"]},
    {"name": "quoted", "input": "\"https://example.com/quoted\"", "urls": ["https://example.com/quoted"]},
    {"name": "single quotes trimmed", "input": "'https://example.com/s'", "urls": ["https://example.com/s"]},
    {"name": "in parentheses", "input": "(see https://example.com/x)", "urls": ["https://example.com/x"]},
    {"name": "balanced parentheses kept", "input": "(see https://en.wikipedia.org/wiki/Foo_(bar)).", "urls": ["https://en.wikipedia.org/wiki/Foo_(bar)"]},
    {"name": "unbalanced bracket", "input": "[https://example.com/b]", "urls": ["https://example.com/b"]},
    {"name": "link suffix the VP appends", "input": "the deck (link: https://example.com/deck)", "urls": ["https://example.com/deck"]},
    {"name": "angle brackets end an address", "input": "<https://example.com/angle>", "urls": ["https://example.com/angle"]},
    {"name": "several, in order", "input": "a https://b.example/1 and www.c.example then http://d.example/2", "urls": ["https://b.example/1", "https://www.c.example", "http://d.example/2"]},
    {"name": "duplicates kept once, first", "input": "https://example.com/a https://example.com/b https://example.com/a", "urls": ["https://example.com/a", "https://example.com/b"]},
    {"name": "www and https forms of one address are one", "input": "www.example.com then https://www.example.com", "urls": ["https://www.example.com"]},
    {"name": "backtick percent-encoded", "input": "https://example.com/a`b", "urls": ["https://example.com/a%60b"]},
    {"name": "curly double quotes trimmed", "input": "“https://example.com/curly”", "urls": ["https://example.com/curly"]},
    {"name": "curly single quotes trimmed", "input": "‘https://example.com/single’", "urls": ["https://example.com/single"]},
    {"name": "curly quote then full stop", "input": "the deck is at “www.example.com/deck.”", "urls": ["https://www.example.com/deck"]},
    {"name": "code span backticks trimmed", "input": "see `https://example.com/code`.", "urls": ["https://example.com/code"]},
    {"name": "trailing backtick run trimmed", "input": "``https://example.com/x```", "urls": ["https://example.com/x"]},
    {"name": "embedded backtick kept, trailing one trimmed", "input": "`https://example.com/a`b`", "urls": ["https://example.com/a%60b"]},
    {"name": "other schemes ignored", "input": "ftp://example.com/f javascript:alert(1) mailto:a@example.com file:///etc/passwd", "urls": []},
    {"name": "no host", "input": "https:// and http:///path", "urls": []},
    {"name": "bare www. is not an address", "input": "www. alone", "urls": []},
    {"name": "inside an email address is not www", "input": "mail bob@www.example.com", "urls": []},
    {"name": "not in the middle of a word", "input": "xwww.example.com and abchttps://example.com", "urls": []},
    {"name": "query and fragment kept", "input": "https://example.com/p?a=1&b=2#frag", "urls": ["https://example.com/p?a=1&b=2#frag"]},
    {"name": "port kept", "input": "http://localhost:3000/x", "urls": ["http://localhost:3000/x"]},
    {"name": "user part", "input": "https://user@example.com/x", "urls": ["https://user@example.com/x"]},
    {"name": "next to a newline", "input": "first\nhttps://example.com/n\nsecond", "urls": ["https://example.com/n"]},
    {"name": "no text", "input": "", "urls": []},
    {"name": "no address", "input": "the slides are on the share", "urls": []},
    {"name": "too long is dropped", "input": "https://example.com/LONG2040", "urls": []},
    {"name": "exactly the limit is kept", "input": "https://example.com/LONG2028", "urls": ["https://example.com/LONG2028"]}
  ],
  "notes": "LONG<n> in an input or url stands for <n> repetitions of the letter a, so the file stays readable; both test suites expand it before use. https://example.com/ is 20 characters, so LONG2028 makes a 2,048-character address and LONG2040 a 2,060-character one."
}
