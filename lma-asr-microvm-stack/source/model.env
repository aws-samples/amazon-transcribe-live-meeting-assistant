# Model selection for the ASR MicroVM image build.
#
# This file is REPLACED at deploy time by the AsrImageSource custom resource,
# which resolves the stack's AsrModelId / AsrSpeakerModelId parameters (or the
# AsrModelUrl / AsrModelSha256 overrides) against models/catalog.json. The
# values committed here are the catalog defaults, so a plain
# `docker build -f Dockerfile .` in this directory reproduces the default image.
#
# Every model is SHA256-verified during the build. An empty ASR_MODEL_SHA256
# fails the build: unverified weights never land in an image.

ASR_MODEL_ID=nemotron-streaming-en-0.6b-560ms-int8
ASR_MODEL_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-nemotron-speech-streaming-en-0.6b-560ms-int8-2026-04-25.tar.bz2
ASR_MODEL_SHA256=78e2b79fcf7271553a74402a76b771b09ea40117a39566a79f52235b23db6358
ASR_MODEL_ARCHIVE=tar.bz2
ASR_MODEL_STRIP_COMPONENTS=1
ASR_MODEL_ENCODER_FILE=encoder.int8.onnx
ASR_MODEL_DECODER_FILE=decoder.int8.onnx
ASR_MODEL_JOINER_FILE=joiner.int8.onnx
ASR_MODEL_TOKENS_FILE=tokens.txt
ASR_MODEL_ENGINE=streaming
ASR_MODEL_LICENSE=NVIDIA Open Model License

ASR_SPEAKER_MODEL_ID=titanet-small
ASR_SPEAKER_MODEL_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/nemo_en_titanet_small.onnx
ASR_SPEAKER_MODEL_SHA256=ad4a1802485d8b34c722d2a9d04249662f2ece5d28a7a039063ca22f515a789e
ASR_SPEAKER_MODEL_LICENSE=CC-BY-4.0

SHERPA_ONNX_VERSION=1.13.4
ONNXRUNTIME_VERSION=1.27.0
