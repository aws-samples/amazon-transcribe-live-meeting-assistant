{
  "name": "lma-websocket",
  "version": "1.0.0",
  "private": true,
  "author": "Babu Srinvasan",
  "license": "Apache-2.0",
  "description": "LCA Websocket Server",
  "main": "src/index.ts",
  "scripts": {
    "setup": "npm install",
    "start": "ts-node src/index.ts",
    "build": "tsc --project tsconfig.json --pretty && npm run lint",
    "buildcheck": "tsc --project tsconfig.json --pretty --noEmit && npm run lint",
    "lint": "eslint . --ext .ts --cache --max-warnings 0",
    "smoke": "ts-node test/fastify5-websocket.smoke.ts",
    "smoke-video": "ts-node test/video-recording.smoke.ts",
    "diarization-fixture": "./test/make-diarization-fixture.sh",
    "diarization-spike": "ts-node test/diarization-spike.ts",
    "diarization-e2e": "ts-node test/diarization-e2e.ts",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "update": "ncu -t minor -u && npm install",
    "clean": "rm -r dist/"
  },
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-kinesis": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1116.0",
    "@fastify/websocket": "^11.3.0",
    "aws-jwt-verify": "^5.2.1",
    "block-stream2": "^2.1.0",
    "buffer-from": "^1.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/block-stream2": "^2.1.3",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
