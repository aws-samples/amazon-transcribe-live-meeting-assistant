<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the .app bundle wrapper (see make-app.sh).

  A bare `swift run` / `swift build` executable has NO bundle, so macOS
  attributes its Microphone + Screen Recording access to the PARENT process
  (Terminal / iTerm). Wrapping the binary in a minimal .app with this plist
  gives the client its OWN TCC identity ("LMAAudioClient") so the permission
  prompts and System Settings toggles are attributed to the app, not Terminal.

  NSMicrophoneUsageDescription is REQUIRED — without it the process is killed
  the instant it touches the microphone API (TCC crash, not a prompt).
  Screen Recording has no plist key; ScreenCaptureKit triggers that prompt at
  runtime and the toggle appears under Privacy & Security > Screen Recording.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>LMAAudioClient</string>
    <key>CFBundleDisplayName</key>
    <string>LMA Audio Client</string>
    <key>CFBundleIdentifier</key>
    <string>com.amazon.lma.audioclient</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>LMAAudioClient</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Regular app: shows in the Dock (with a REC badge while recording) in
         addition to the menu-bar item. On notched MacBooks the menu-bar icon
         can be silently hidden when the bar is crowded — worst of all, the
         system's orange mic indicator appears at the moment recording starts
         and can push our icon out of view — so the Dock is the reliable,
         always-visible control surface. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>LMA needs the microphone to transcribe your side of the meeting.</string>
</dict>
</plist>
