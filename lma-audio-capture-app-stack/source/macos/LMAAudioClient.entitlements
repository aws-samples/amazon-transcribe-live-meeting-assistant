<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime (required for Apple notarization).
  Microphone access is an entitlement; Screen Recording is NOT — it is a
  runtime TCC consent prompt triggered by ScreenCaptureKit, not declared here.
  A Developer ID (outside-App-Store) app does not need to be sandboxed, so
  com.apple.security.app-sandbox is intentionally omitted.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
