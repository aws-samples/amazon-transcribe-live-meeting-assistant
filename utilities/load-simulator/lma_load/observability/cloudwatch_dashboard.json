{
  "_comment": "Template CloudWatch dashboard for LMA Load Simulator observability. Substitute ${region}, ${call_data_stream}, ${cep_function}, ${appsync_api_id} and ${vp_cluster} before posting with put-dashboard — the README's 'CloudWatch observability' section has the exact commands that resolve each one. Every placeholder here must be filled: an unsubstituted one leaves a widget querying a metric that does not exist, which renders as an empty graph rather than an error. For a dashboard that needs no substitution at all, use the one the stack deploys (<stack-name>-<region>) — see docs/monitoring.md.",
  "widgets": [
    {
      "type": "metric",
      "properties": {
        "title": "Transcribe concurrent streaming sessions (account-wide)",
        "region": "${region}",
        "metrics": [
          ["AWS/Transcribe", "ConcurrentStreamsCount", {"label": "Account total"}],
          ["AWS/Transcribe", "ConcurrentStreamsCount", "Domain", "Transcribe", "ServiceType", "streaming", {"label": "Transcribe streaming"}]
        ],
        "stat": "Maximum",
        "period": 60
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "Kinesis CallDataStream throughput",
        "region": "${region}",
        "metrics": [
          ["AWS/Kinesis", "IncomingRecords", "StreamName", "${call_data_stream}"],
          [".",           "WriteProvisionedThroughputExceeded", ".", "."]
        ],
        "stat": "Sum",
        "period": 60
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "call_event_processor Lambda",
        "region": "${region}",
        "metrics": [
          ["AWS/Lambda", "ConcurrentExecutions", "FunctionName", "${cep_function}"],
          [".",          "Duration",              ".", "."],
          [".",          "Errors",                ".", "."],
          [".",          "Throttles",             ".", "."]
        ],
        "stat": "Sum",
        "period": 60
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "Bedrock invocations / throttles",
        "region": "${region}",
        "metrics": [
          ["AWS/Bedrock", "Invocations"],
          [".",           "InvocationThrottles"],
          [".",           "InvocationClientErrors"]
        ],
        "stat": "Sum",
        "period": 60
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "ECS VP cluster task count",
        "region": "${region}",
        "metrics": [
          ["ECS/ContainerInsights", "RunningTaskCount", "ClusterName", "${vp_cluster}"]
        ],
        "stat": "Maximum",
        "period": 60
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "AppSync 4xx/5xx",
        "region": "${region}",
        "metrics": [
          ["AWS/AppSync", "4XXError", "GraphQLAPIId", "${appsync_api_id}"],
          [".",           "5XXError", ".", "."],
          [".",           "Latency",  ".", "."]
        ],
        "stat": "Sum",
        "period": 60
      }
    }
  ]
}
