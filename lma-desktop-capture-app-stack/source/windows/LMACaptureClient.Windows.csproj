<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LMA native Windows desktop capture client. Single project, dual-mode:
      launched with NO CLI flags  -> WPF system-tray app (GUI)
      launched with any CLI flag   -> headless CLI streaming to stdout
    (mirrors the macOS app's main.swift dispatch).

    OutputType=WinExe so the tray app has no console window when idle; the CLI
    path re-attaches to the parent console via AttachConsole (see Program.cs).
    UseWPF so we can build the tray popup panel + NotifyIcon.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LMACaptureClient</AssemblyName>
    <RootNamespace>LMA</RootNamespace>
    <!-- Shown by Windows wherever it names the app: the taskbar button's
         accessible name and hover thumbnail, Task Manager, and the file
         properties dialog. Without these it reads as the bare "LMACaptureClient". -->
    <Product>LMA Capture Client</Product>
    <AssemblyTitle>LMA Capture Client</AssemblyTitle>
    <Company>Amazon Web Services</Company>
    <Description>Streams your microphone, system (meeting) audio, and optionally your screen to Live Meeting Assistant.</Description>
    <!-- No custom app.manifest: .NET 8 already defaults to asInvoker (no
         elevation) and WPF is per-monitor-DPI-aware by default on Win10+.
         A hand-written manifest was found to trigger an SxS load error. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- We build the UI in code (no XAML markup) so there is no App.xaml entry
         point; Program.Main is our explicit entry point. -->
    <StartupObject>LMA.Program</StartupObject>
    <!-- ScreenRecorderLib is a C++/CLI mixed-mode assembly: its .targets refuses
         to build on 'AnyCPU' and picks the native DLL off $(Platform). Listing
         x64 in Platforms is NOT enough — that only declares which platforms are
         legal, while MSBuild still defaults the ACTIVE $(Platform) to AnyCPU
         (set in Microsoft.Common.props, imported before this PropertyGroup), so
         a plain `dotnet build/publish` failed with "does not work correctly on
         'AnyCPU' platform". Set it explicitly, but leave an explicit
         -p:Platform=... on the command line able to win.
         AppendPlatformToOutputPath: a non-AnyCPU platform normally inserts an
         extra "x64\" segment (bin\x64\Release\...); suppress it so the output
         stays at bin\$(Configuration)\net8.0-windows\win-x64\ where
         build-windows.ps1 and the README's by-hand instructions expect it. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI loopback (system audio) + capture (mic) + resampling. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- WPF tray icon helper (NotifyIcon for WPF). -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- Optional desktop-video capture: wraps Windows.Graphics.Capture +
         Media Foundation H.264 encoding with display/window selection and
         fragmented-MP4 output to a Stream (what we forward to the socket).
         MIT-licensed. Only exercised when the user enables "Also record
         screen video" — audio-only usage never loads it. -->
    <PackageReference Include="ScreenRecorderLib" Version="6.2.0" />
  </ItemGroup>

  <!-- Ship the sample config next to the exe (the packaging pipeline overwrites
       it with the deployment's real values — see build-windows.ps1 / template). -->
  <ItemGroup>
    <None Include="lma-config.json" Condition="Exists('lma-config.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
